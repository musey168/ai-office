{
  "name": "@ai-office/web-server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "The single HTTP entry point of the AI Office web port: static renderer assets, the RPC bridge, the event stream and the byte endpoints",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:renderers": "node build/renderers.mjs",
    "start": "node --experimental-strip-types src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ai-office/rpc-bridge": "file:../rpc-bridge",
    "@ai-office/workspace-store": "file:../workspace-store"
  }
}
